---
import geist from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

import { headScript } from "../scripts/head";
import { AUTHOR } from "../lib/config";
import type { HostKind, Language } from "../lib/config";
import { OG_IMAGE_SIZE, serializeJsonLd } from "../lib/seo";
import type { PageMeta } from "../lib/seo";
import { feedHref } from "../lib/urls";
import { t } from "../i18n";

interface Props {
  lang: Language;
  host: HostKind;
  meta: PageMeta;
  /** Runs the boot screen gate in the head script (home page). */
  boot: boolean;
  /** The page's CSS, in cascade order. */
  styles: string;
}

const { lang, host, meta, boot, styles } = Astro.props;
const dict = t(lang);
const ogLocale = lang === "pt" ? "pt_BR" : "en_US";
const ogLocaleAlternate = lang === "pt" ? "en_US" : "pt_BR";

/**
 * Same-origin page links are prefetched when the pointer rests on one (or on touch start),
 * so the next page's HTML is already here when it is followed. Documents are only fetched,
 * never prerendered: a prerender would run the head script and the client module early (boot
 * cookie, LED blink, language reload, theme read). Links with an extension (feeds, résumés,
 * markdown) and the language links are left alone.
 */
const speculationRules = JSON.stringify({
  prefetch: [
    {
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: "/*.*" } },
          { not: { selector_matches: "[hreflang]" } },
        ],
      },
      eagerness: "moderate",
    },
  ],
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<meta name="author" content={AUTHOR.name} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#f6f6f3" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c0d0f" media="(prefers-color-scheme: dark)" />
<script is:inline set:html={headScript({ boot })} />
{[geist, geistMono].map((font) => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={styles} />
<script is:inline type="speculationrules" set:html={speculationRules} />
{meta.canonical && <link rel="canonical" href={meta.canonical} />}
<meta name="robots" content={meta.noindex ? "noindex" : "index, follow, max-image-preview:large"} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={`${dict.site.title} · ${dict.blog.title}`} href={feedHref(host)} />
{meta.markdownHref && <link rel="alternate" type="text/markdown" href={meta.markdownHref} />}
<meta property="og:type" content={meta.ogType} />
<meta property="og:site_name" content={dict.site.title} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
{meta.canonical && <meta property="og:url" content={meta.canonical} />}
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />
<meta property="og:image" content={meta.ogImage.url} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
<meta property="og:image:alt" content={meta.ogImage.alt} />
{
  meta.article && (
    <>
      <meta property="article:published_time" content={meta.article.publishedTime} />
      <meta property="article:author" content={AUTHOR.name} />
      {meta.article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={AUTHOR.twitter} />
<meta name="twitter:creator" content={AUTHOR.twitter} />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.ogImage.url} />
<meta name="twitter:image:alt" content={meta.ogImage.alt} />
{meta.jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />)}
