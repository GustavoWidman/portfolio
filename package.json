{
  "name": "portfolio",
  "version": "3.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:headings": "bun scripts/check-heading-ids.ts",
    "check:dates": "bun scripts/check-publication-dates.ts && TZ=UTC bun scripts/check-publication-dates.ts",
    "check:meta": "bun scripts/check-metadata.ts",
    "check:routes": "bun scripts/check-routes.ts",
    "check:replays": "bun scripts/check-replays.ts",
    "og:preview": "bun scripts/og-preview.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "postinstall": "bun2nix -o .bun.nix",
    "compile-resumes": "bash scripts/compile-resumes.sh"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.7",
    "github-slugger": "^2.0.0",
    "harfbuzzjs": "0.10.0",
    "hast-util-to-html": "^9.0.6",
    "hast-util-to-string": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "0.63.2",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "wawoff2": "2.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "bun2nix": "^2.1.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "~6.0.3"
  }
}
